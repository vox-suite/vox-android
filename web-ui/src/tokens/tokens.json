{
  "$schema": "https://json.schemastore.org/design-tokens",
  "name": "Vox Design System",
  "version": "1.0.0",
  "color": {
    "light": {
      "parchment": "#f6f3f1",
      "lakeBlue": "#2b59d1",
      "periwinkleMist": "#cfdaf5",
      "skyBlue": "#a0b5eb",
      "mint": "#a7fccd",
      "coral": "#ff9473",
      "gold": "#ecda98",
      "crimson": "#f37a0a",
      "offBlack": "#242424",
      "ink": "#000000",
      "graphite": "#4e4d4d",
      "smoke": "#797776",
      "ash": "#cecac8"
    },
    "dark": {
      "parchment": "#141312",
      "lakeBlue": "#3d6cf0",
      "periwinkleMist": "#1c2438",
      "skyBlue": "#7f98d4",
      "mint": "#7be3af",
      "coral": "#f57b56",
      "gold": "#d9c47e",
      "crimson": "#d96602",
      "offBlack": "#f6f3f1",
      "ink": "#0a0a09",
      "graphite": "#aba7a2",
      "smoke": "#7b7773",
      "ash": "#2c2a27",
      "surface": "#1c1b19"
    }
  },
  "typography": {
    "fonts": {
      "serif": "'Untitled Serif', 'Newsreader', ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif",
      "mono": "'ABC Diatype Mono', 'JetBrains Mono', 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
      "sans": "'Untitled Sans', 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
    },
    "weights": {
      "regular": 400,
      "medium": 500
    },
    "scale": {
      "caption": { "size": "12px", "lineHeight": 1.2, "letterSpacing": "-0.4px" },
      "bodySm": { "size": "14px", "lineHeight": 1.35, "letterSpacing": "-0.28px" },
      "body": { "size": "16px", "lineHeight": 1.35, "letterSpacing": "-0.4px" },
      "label": { "size": "18px", "lineHeight": 1.2, "letterSpacing": "-0.4px" },
      "bodyLg": { "size": "20px", "lineHeight": 1.35, "letterSpacing": "-0.4px" },
      "subheading": { "size": "24px", "lineHeight": 1.2, "letterSpacing": "-0.48px" },
      "headingSm": { "size": "32px", "lineHeight": 1.2, "letterSpacing": "-0.64px" },
      "heading": { "size": "40px", "lineHeight": 1.2, "letterSpacing": "-0.8px" },
      "headingLg": { "size": "48px", "lineHeight": 1.2, "letterSpacing": "-0.96px" },
      "display": { "size": "80px", "lineHeight": 1.2, "letterSpacing": "-1.6px" }
    }
  },
  "spacing": {
    "8": "8px",
    "16": "16px",
    "24": "24px",
    "32": "32px",
    "40": "40px",
    "64": "64px",
    "72": "72px",
    "80": "80px",
    "200": "200px",
    "216": "216px"
  },
  "radius": {
    "tags": "9999px",
    "cards": "40px",
    "pills": "9999px",
    "buttons": "100px",
    "sm": "6px",
    "md": "8px",
    "2xl": "16px",
    "3xl": "40px",
    "full": "100px"
  },
  "layout": {
    "pageMaxWidth": "1432px",
    "sectionGap": "64px",
    "cardPadding": "40px",
    "elementGap": "16px"
  },
  "elevation": {
    "md": "rgba(0, 0, 0, 0.1) 0px 0px 10px 0px",
    "darkMd": "rgba(0, 0, 0, 0.4) 0px 0px 12px 0px"
  }
}
